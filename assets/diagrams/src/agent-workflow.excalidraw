   "locked": false,
   "text": "Harbormaster supplies the transition.",
   "fontSize": 28,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Harbormaster supplies the transition.",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "jpMwhd45V-J5K-mq-h3R9",
   "type": "text",
   "x": 66,
   "y": 244,
   "width": 472.75680000000017,
   "height": 210,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a5",
   "roundness": null,
   "seed": 351549789,
   "version": 2,
   "versionNonce": 913731293,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729549,
   "link": null,
   "locked": false,
   "text": "Harbormaster organizes vessel evidence.\nThe analyst still interprets that evidence.\n\nSpatial Atlas explores the next question.\nHow can an agent compute useful facts\nbefore it explains a scene to the user?\nThe connection is conceptual.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Harbormaster organizes vessel evidence.\nThe analyst still interprets that evidence.\n\nSpatial Atlas explores the next question.\nHow can an agent compute useful facts\nbefore it explains a scene to the user?\nThe connection is conceptual.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
