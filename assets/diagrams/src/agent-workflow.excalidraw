  {
   "id": "IcI3ol6W7QN4o0zFz2f4i",
   "type": "text",
   "x": 66,
   "y": 1069,
   "width": 458.0160000000002,
   "height": 300,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aB",
   "roundness": null,
   "seed": 381450877,
   "version": 2,
   "versionNonce": 1683529725,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729550,
   "link": null,
   "locked": false,
   "text": "The August 29 record reports\n350 tests plus 63 subtests.\n\nFour paths produced eight rows each.\nThe 32 predictions remained label-free.\nThe smoke used zero retries.\nWarning scans and cleanup passed.\nTerminal sealing passed.\n\nNo accuracy comparison was computed.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The August 29 record reports\n350 tests plus 63 subtests.\n\nFour paths produced eight rows each.\nThe 32 predictions remained label-free.\nThe smoke used zero retries.\nWarning scans and cleanup passed.\nTerminal sealing passed.\n\nNo accuracy comparison was computed.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
