   "labelPosition": null
  },
  {
   "id": "CIVrpnxDoQ09ESmik6Es6",
   "type": "text",
   "x": 66,
   "y": 1549,
   "width": 477.53760000000005,
   "height": 210,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aE",
   "roundness": null,
   "seed": 791397747,
   "version": 2,
   "versionNonce": 351037427,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729550,
   "link": null,
   "locked": false,
   "text": "The A2A dispatcher also selects ML tasks.\nThat handler generates an ML pipeline.\nExecution is disabled by default.\nIt needs opt-in and worker attestation.\nIts attempts and execution are bounded.\n\nThese controls are not a full sandbox.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The A2A dispatcher also selects ML tasks.\nThat handler generates an ML pipeline.\nExecution is disabled by default.\nIt needs opt-in and worker attestation.\nIts attempts and execution are bounded.\n\nThese controls are not a full sandbox.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
