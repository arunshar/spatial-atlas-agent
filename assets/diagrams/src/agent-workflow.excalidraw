  {
   "id": "OVCPBoiaLpbN8ngW-o22J",
   "type": "text",
   "x": 820,
   "y": 205,
   "width": 1078.4880000000003,
   "height": 34.5,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b01",
   "roundness": null,
   "seed": 1438144573,
   "version": 2,
   "versionNonce": 141598141,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The application path uses a familiar client, server and response interaction.",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The application path uses a familiar client, server and response interaction.",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "wGQu-YQtwMBqGVbHbj0Ef",
   "type": "text",
   "x": 1900,
   "y": 630,
   "width": 885.4599999999999,
   "height": 62.5,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b02",
   "roundness": null,
   "seed": 1120278035,
   "version": 2,
   "versionNonce": 1790896275,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The same model client supplies configured Fast, Standard and Strong tiers.\nThe tier names describe roles. They need not select different models.",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The same model client supplies configured Fast, Standard and Strong tiers.\nThe tier names describe roles. They need not select different models.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "K0Qbth9Qkem4jZBOr50lb",
   "type": "text",
   "x": 1900,
   "y": 745,
   "width": 580.3248000000003,
   "height": 60,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b03",
   "roundness": null,
   "seed": 1155287197,
   "version": 2,
   "versionNonce": 1399840285,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The self-grade is not calibrated confidence.\nThe formatter does not verify factual correctness.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The self-grade is not calibrated confidence.\nThe formatter does not verify factual correctness.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "Hel36qvnMMpNRKd9p7cet",
   "type": "text",
   "x": 820,
   "y": 1195,
   "width": 341.19120000000015,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b04",
   "roundness": null,
   "seed": 1012915123,
   "version": 2,
   "versionNonce": 1117412915,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The task store is in memory.\nIt is not a durable job database.",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The task store is in memory.\nIt is not a durable job database.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "e0gIaAJC3hRdzaQ4D2GXg",
   "type": "text",
   "x": 1330,
   "y": 1270,
   "width": 1132.8,
   "height": 62.5,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b05",
   "roundness": null,
   "seed": 518204669,
   "version": 2,
   "versionNonce": 292033149,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The ordinary A2A wrapper does not supply the strict QSpatial protocol and sample metadata.\nThe evaluation path below has its own entry. Its repeated handler uses the same underlying code.",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The ordinary A2A wrapper does not supply the strict QSpatial protocol and sample metadata.\nThe evaluation path below has its own entry. Its repeated handler uses the same underlying code.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "Rap5T-OyDIVffmnRpOZoz",
   "type": "text",
   "x": 820,
   "y": 1490,
   "width": 1065.0420000000006,
   "height": 34.5,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b06",
   "roundness": null,
   "seed": 368045395,
   "version": 2,
   "versionNonce": 649469907,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The recorded V37 evaluation exercises a separate, frozen four-path entry.",
   "fontSize": 30,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The recorded V37 evaluation exercises a separate, frozen four-path entry.",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "q3GyODKfuWoGYeEC7Hucz",
   "type": "text",
   "x": 820,
   "y": 1990,
   "width": 750.4416000000003,
   "height": 120,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b07",
   "roundness": null,
   "seed": 1934525789,
   "version": 2,
   "versionNonce": 1595587293,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The scenegraph uses the correct image.\nThe question-only arm withholds the image.\nThe metric arms use either the correct image or a shuffled image.\nOnly the metric arms follow the perception boxes above.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The scenegraph uses the correct image.\nThe question-only arm withholds the image.\nThe metric arms use either the correct image or a shuffled image.\nOnly the metric arms follow the perception boxes above.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "202hnWMEwMKn70LM9LCXU",
   "type": "text",
   "x": 2270,
   "y": 1990,
   "width": 845.2608000000006,
   "height": 90,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b08",
   "roundness": null,
   "seed": 315411187,
   "version": 2,
   "versionNonce": 1093184883,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "The strict route never silently switches to estimated scene coordinates.\nThe generic metric engine has a separate fallback behavior.\nThe terminal finalizer verifies lifecycle closure, not answer correctness.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The strict route never silently switches to estimated scene coordinates.\nThe generic metric engine has a separate fallback behavior.\nThe terminal finalizer verifies lifecycle closure, not answer correctness.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "QmFUaOYaIU4HqENlytRvl",
   "type": "text",
   "x": 826.2534508035233,
   "y": 2145.659550066296,
   "width": 1635.365,
   "height": 28.749999999999996,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b09",
   "roundness": null,
   "seed": 1701827005,
   "version": 93,
   "versionNonce": 54318222,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789097758652,
   "created": 1789095729551,
   "link": null,
   "locked": false,
   "text": "Harbormaster connects through a shared research question about evidence. This board claims no deployed connection between the projects.",
   "fontSize": 25,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Harbormaster connects through a shared research question about evidence. This board claims no deployed connection between the projects.",
   "autoResize": true,
   "lineHeight": 1.15,
   "labelPosition": null
  }
