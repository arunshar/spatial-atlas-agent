   "lineHeight": 1.15,
   "labelPosition": null
  },
  {
   "id": "gWyeOA5tFgnTaRR_1DT-O",
   "type": "text",
   "x": 66,
   "y": 629,
   "width": 443.2752000000001,
   "height": 270,
   "angle": 0,
   "strokeColor": "#252525",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a8",
   "roundness": null,
   "seed": 996868243,
   "version": 2,
   "versionNonce": 747672339,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789095729551,
   "created": 1789095729549,
   "link": null,
   "locked": false,
   "text": "The user asks a spatial question.\nThe system makes inputs explicit.\nThe model receives computed facts.\nThe client receives a result and status.\n\nPerception errors can remain.\nRepeatable arithmetic does not make\nthe estimated geometry ground truth.\nThe answer can still be wrong.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The user asks a spatial question.\nThe system makes inputs explicit.\nThe model receives computed facts.\nThe client receives a result and status.\n\nPerception errors can remain.\nRepeatable arithmetic does not make\nthe estimated geometry ground truth.\nThe answer can still be wrong.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
