   "text": "The MLE handler is a separate branch.",
   "fontSize": 28,
   "baseFontSize": null,
   "fontFamily": 7,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The MLE handler is a separate branch.",
