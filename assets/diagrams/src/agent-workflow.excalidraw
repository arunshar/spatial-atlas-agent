   "updated": 1789095729551,
   "created": 1789095729550,
   "link": null,
   "locked": false,
   "text": "Protected scoring must test the answers.\nA native persistent kernel is proposed.\nAn answer-evidence journal is proposed.\nAn answer verifier is proposed.\n\nThe current journal records predictions.\nIt does not prove which facts the\nfinal model answer actually used.",
   "fontSize": 24,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Protected scoring must test the answers.\nA native persistent kernel is proposed.\nAn answer-evidence journal is proposed.\nAn answer verifier is proposed.\n\nThe current journal records predictions.\nIt does not prove which facts the\nfinal model answer actually used.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
