   "updated": 1788497881430,
   "link": null,
   "locked": false,
   "text": "SpatialEntity   id, label, pos, attrs, zone\nSpatialRelation subj, pred, obj, distance\nSpatialScene    entities, relations, fact sheet\nMetricEvidence  protocol, provenance, digests,\n                range checks, fallback_used\nPrescoreRow     prediction text, run metadata,\n                and no ground-truth field\nControlMapping  digest-bound, bijective, and\n                free of fixed points",
   "fontSize": 12,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SpatialEntity   id, label, pos, attrs, zone\nSpatialRelation subj, pred, obj, distance\nSpatialScene    entities, relations, fact sheet\nMetricEvidence  protocol, provenance, digests,\n                range checks, fallback_used\nPrescoreRow     prediction text, run metadata,\n                and no ground-truth field\nControlMapping  digest-bound, bijective, and\n                free of fixed points",
   "autoResize": true,
