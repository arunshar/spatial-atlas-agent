   "type": "text",
   "x": 90,
   "y": 1406.0,
   "width": 249.2072000000001,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
