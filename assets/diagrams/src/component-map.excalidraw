   "isDeleted": false,
   "boundElements": [],
   "updated": 1788497881430,
   "link": null,
   "locked": false,
   "text": "POST /               JSON-RPC task submit\nGET  /.well-known/   agent card, two skills\n       agent-card.json\n\neval_bench.py\n  --engine {scenegraph, metric}\n  --image-mode {correct, question-only,\n                shuffled}\n  --control-mapping <artifact>\n\nFour constraints. question-only needs\nscenegraph. shuffled needs metric AND a\ncontrol mapping. A mapping is rejected for\nany other image mode. Four of six admitted.",
   "fontSize": 12,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "POST /               JSON-RPC task submit\nGET  /.well-known/   agent card, two skills\n       agent-card.json\n\neval_bench.py\n  --engine {scenegraph, metric}\n  --image-mode {correct, question-only,\n                shuffled}\n  --control-mapping <artifact>\n\nFour constraints. question-only needs\nscenegraph. shuffled needs metric AND a\ncontrol mapping. A mapping is rejected for\nany other image mode. Four of six admitted.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
