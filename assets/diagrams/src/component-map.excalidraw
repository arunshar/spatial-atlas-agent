   "version": 4,
   "versionNonce": 362885283,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788498377133,
   "link": null,
   "locked": false,
   "text": "Compute-grounded reasoning: code computes selected facts before the model answers. One A2A service, two handlers, four comparison paths.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Compute-grounded reasoning: code computes selected facts before the model answers. One A2A service, two handlers, four comparison paths.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
