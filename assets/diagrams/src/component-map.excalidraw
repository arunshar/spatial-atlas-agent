  {
   "id": "JJ-AXuN05eeZVDnGQky9h",
   "type": "text",
   "x": 2950,
   "y": 1400.0,
   "width": 288.64880000000016,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
