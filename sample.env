# Spatial Atlas Configuration
# Copy to .env and fill in your API keys.
# Loopback development needs only OPENAI_API_KEY. Every non-loopback bind also
# requires ATLAS_BEARER_TOKEN.

# LLM Provider API Keys
OPENAI_API_KEY=sk-...

# Request authentication for non-loopback binds
# Set a unique random value of at least 32 characters. Never commit the real value.
ATLAS_BEARER_TOKEN=

# Model overrides (optional; defaults shown)
# ATLAS_FAST_MODEL=openai/gpt-4.1-mini
# ATLAS_STANDARD_MODEL=openai/gpt-4.1
# ATLAS_STRONG_MODEL=openai/gpt-4.1
# ATLAS_VISION_MODEL=openai/gpt-4.1
